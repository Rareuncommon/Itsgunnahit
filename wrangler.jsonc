{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chest-tracker",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "build": { "command": "node scripts/build-assets.mjs", "watch_dir": "public" },
  "durable_objects": {
    "bindings": [{ "name": "TRACKER", "class_name": "Tracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tracker"] }]
,
  // Your own domain (must be on your Cloudflare account). Change or remove as needed.
  "workers_dev": true,
  "routes": [{ "pattern": "chests.studioprompt.net", "custom_domain": true }]
}
